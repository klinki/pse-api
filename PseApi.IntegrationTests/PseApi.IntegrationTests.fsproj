<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Tests.fs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.MTP" Version="10.1.1" />
        <PackageReference Include="Foq" Version="1.8.0" />
        <PackageReference Include="FsUnit.xUnit" Version="8.0.0" />
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.23" />
        <PackageReference Include="OpenAPITypeProvider" Version="2.3.0" />
        <!-- Transitive dependency pin: patched version of package pulled in by OpenAPITypeProvider -->
        <PackageReference Include="YamlDotNet" Version="5.0.0" />
        <PackageReference Include="xunit.v3" Version="4.0.3" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\PseApi\PseApi.csproj" />
    </ItemGroup>

    <ItemGroup>
      <None Update="swagger.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

</Project>
